@page
@model GiftStore.Web.Pages.Admin.Supplier.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "وضعیت تامین‌کننده Gift-i-Card";
}

<h1 class="text-2xl font-black text-gray-900 mb-6">اتصال و مانده حساب Gift-i-Card</h1>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
        <span class="text-xs text-gray-400 block mb-1">وضعیت ارتباط با API</span>
        <span class="text-lg font-bold @(Model.Status?.IsConnected == true ? "text-emerald-600" : "text-red-600")">
            @(Model.Status?.IsConnected == true ? "متصل و فعال ✓" : "قطع ارتباط ✕")
        </span>
    </div>
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
        <span class="text-xs text-gray-400 block mb-1">موجودی کیف پول تامین</span>
        <span class="text-xl font-black text-indigo-700">
            @Model.Status?.WalletBalanceToman.ToString("N0") @Model.Status?.Currency
        </span>
    </div>
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center justify-between">
        <div>
            <span class="text-xs text-gray-400 block mb-1">همگام‌سازی کاتالوگ</span>
            <span class="text-xs text-gray-600">دریافت آخرین قیمت‌ها و موجودی</span>
        </div>
        <form method="post" asp-page-handler="Sync">
            <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold transition">
                همگام‌سازی دستی
            </button>
        </form>
    </div>
</div>
