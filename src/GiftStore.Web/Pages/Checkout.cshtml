@page
@model GiftStore.Web.Pages.CheckoutModel
@{
    ViewData["Title"] = "تایید سفارش و پرداخت";
}

<div class="container mx-auto px-4 py-10 max-w-2xl">
    <h1 class="text-2xl font-black text-gray-900 mb-6">پیش‌فاکتور و پرداخت سفارش</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl text-sm mb-6">
            @Model.ErrorMessage
        </div>
    }

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6">
        <h2 class="font-bold text-gray-800 text-base mb-4 pb-2 border-b border-gray-100">اقلام سفارش</h2>
        
        <div class="flex justify-between items-center py-2">
            <div>
                <span class="font-semibold text-gray-900 block">@Model.ProductTitle - @Model.VariantTitle</span>
                <span class="text-xs text-gray-400">تعداد: @Model.Quantity عدد</span>
            </div>
            <span class="font-bold text-indigo-700">@Model.ItemTotalToman.ToString("N0") تومان</span>
        </div>

        <div class="mt-4 pt-4 border-t border-gray-100 flex justify-between items-center text-base">
            <span class="font-bold text-gray-900">مبلغ نهایی قابل پرداخت:</span>
            <span class="font-black text-xl text-indigo-600">@Model.ItemTotalToman.ToString("N0") تومان</span>
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="VariantMappingId" />
        <input type="hidden" asp-for="Quantity" />
        <input type="hidden" asp-for="ExpectedUnitPriceToman" />

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-6 space-y-4">
            <h2 class="font-bold text-gray-800 text-base mb-2">اطلاعات خریدار جهت تحویل سفارش</h2>
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">ایمیل (جهت ثبت و ارسال فاکتور):</label>
                <input type="email" asp-for="CustomerEmail" required class="w-full p-3 rounded-lg border border-gray-200 outline-none text-sm text-left dir-ltr" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">شماره همراه (اختیاری):</label>
                <input type="tel" asp-for="CustomerMobile" placeholder="۰۹۱۲۳۴۵۶۷۸۹" class="w-full p-3 rounded-lg border border-gray-200 outline-none text-sm text-left dir-ltr" />
            </div>
        </div>

        <button type="submit" class="w-full py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-md transition text-base">
            انتقال به درگاه امن بانکی و پرداخت 💳
        </button>
    </form>
</div>
