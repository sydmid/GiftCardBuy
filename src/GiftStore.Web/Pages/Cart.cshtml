@page
@model GiftStore.Web.Pages.CartModel
@{
    ViewData["Title"] = "سبد خرید";
}

<div class="container mx-auto px-4 py-10 max-w-3xl">
    <h1 class="text-2xl font-black text-gray-900 mb-6">سبد خرید شما</h1>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 text-center">
        <div class="text-5xl mb-4">🛒</div>
        <h2 class="text-lg font-bold text-gray-800 mb-2">سبد خرید آماده تحویل آنی</h2>
        <p class="text-xs text-gray-500 mb-6 leading-relaxed">
            جهت تسریع فرآیند و دریافت کد بلافاصله پس از پرداخت، می‌توانید مستقیماً از صفحه هر محصول گزینه «خرید آنی» را انتخاب نمایید.
        </p>
        <a href="/" class="py-3 px-8 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl text-sm transition inline-block">
            مشاهده و خرید گیفت کارت‌ها
        </a>
    </div>
</div>
