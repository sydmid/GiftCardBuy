@page
@model GiftStore.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "ورود به حساب کاربری";
}

<div class="container mx-auto px-4 py-16 max-w-md">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
        <h1 class="text-2xl font-black text-gray-900 mb-2 text-center">ورود به حساب کاربری</h1>
        <p class="text-xs text-gray-400 text-center mb-6">جهت مشاهده سفارشات و دریافت کدهای خریداری شده</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded-xl text-xs mb-4">
                @Model.ErrorMessage
            </div>
        }

        <form method="post" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">ایمیل:</label>
                <input type="email" asp-for="Email" required class="w-full p-2.5 rounded-lg border border-gray-200 text-sm text-left dir-ltr outline-none" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">کلمه عبور:</label>
                <input type="password" asp-for="Password" required class="w-full p-2.5 rounded-lg border border-gray-200 text-sm text-left dir-ltr outline-none" />
            </div>

            <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl transition text-sm">
                ورود
            </button>
        </form>

        <div class="mt-6 pt-4 border-t border-gray-100 text-center text-xs text-gray-500">
            حساب کاربری ندارید؟ <a href="/Account/Register" class="text-indigo-600 font-bold hover:underline">ثبت‌نام سریع</a>
        </div>
    </div>
</div>
