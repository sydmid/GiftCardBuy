@page
@model GiftStore.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "ثبت‌نام در گیفتی‌کارت‌بای";
}

<div class="container mx-auto px-4 py-16 max-w-md">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
        <h1 class="text-2xl font-black text-gray-900 mb-2 text-center">ثبت‌نام حساب کاربری</h1>
        <p class="text-xs text-gray-400 text-center mb-6">کدهای خریداری شده شما تا همیشه در حسابتان امن باقی می‌ماند</p>

        <form method="post" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">ایمیل معتبر:</label>
                <input type="email" asp-for="Email" required class="w-full p-2.5 rounded-lg border border-gray-200 text-sm text-left dir-ltr outline-none" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">کلمه عبور امن:</label>
                <input type="password" asp-for="Password" required class="w-full p-2.5 rounded-lg border border-gray-200 text-sm text-left dir-ltr outline-none" />
            </div>

            <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl transition text-sm">
                ایجاد حساب کاربری
            </button>
        </form>

        <div class="mt-6 pt-4 border-t border-gray-100 text-center text-xs text-gray-500">
            قبلاً حساب ساخته‌اید؟ <a href="/Account/Login" class="text-indigo-600 font-bold hover:underline">وارد شوید</a>
        </div>
    </div>
</div>
