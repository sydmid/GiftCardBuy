@page
@model GiftStore.Web.Pages.Account.OrderDetailsModel
@{
    ViewData["Title"] = $"جزئیات سفارش {Model.Order?.OrderNumber}";
}

<div class="container mx-auto px-4 py-10 max-w-3xl">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-black text-gray-900">سفارش @Model.Order?.OrderNumber</h1>
            <span class="text-xs text-gray-400">ثبت شده در: @Model.Order?.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
        </div>
        <span class="px-3 py-1 rounded-full text-xs font-bold @(Model.Order?.Status == OrderStatus.Fulfilled ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
            وضعیت: @Model.Order?.Status
        </span>
    </div>

    <!-- Cards Section -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-8">
        <h2 class="font-bold text-gray-900 text-base mb-4 pb-2 border-b border-gray-100 flex items-center gap-2">
            <span>🔐</span>
            <span>کدهای گیفت‌کارت خریداری شده</span>
        </h2>

        @if (Model.Codes.Count == 0)
        {
            <div class="text-center py-6 text-sm text-gray-500">
                <p>کدها در حال حاضر در دسترس نیستند یا سفارش هنوز به اتمام نرسیده است.</p>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var code in Model.Codes)
                {
                    <div class="code-card p-4 rounded-xl border border-indigo-100 bg-indigo-50/30 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
                        <div>
                            <span class="text-xs text-gray-400 block">سریال: @code.SerialNumberMasked</span>
                            <span id="code-val-@code.Id" class="font-mono font-bold text-base text-gray-800 tracking-wider">••••••••••••••••</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" onclick="revealCode('@code.Id')" class="btn-reveal px-3 py-1.5 bg-white hover:bg-indigo-600 hover:text-white border border-indigo-200 text-indigo-700 text-xs font-bold rounded-lg transition shadow-sm">
                                👁️ نمایش کد
                            </button>
                            <button type="button" onclick="copyCode('@code.Id')" class="btn-copy px-3 py-1.5 bg-indigo-600 text-white hover:bg-indigo-700 text-xs font-bold rounded-lg transition shadow-sm">
                                📋 کپی
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
