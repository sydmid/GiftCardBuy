@page
@model GiftStore.Web.Pages.Blog.PostModel
@{
    ViewData["Title"] = Model.Article?.SeoTitle ?? Model.Article?.Title ?? "مقاله وبلاگ";
    ViewData["MetaDescription"] = Model.Article?.SeoDescription ?? Model.Article?.Excerpt;
    ViewData["CanonicalUrl"] = Model.Article?.CanonicalUrl;
    ViewData["NoIndex"] = Model.Article?.NoIndex ?? false;
}

@if (Model.Article != null)
{
    <!-- Article JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Article",
      "headline": "@Model.Article.Title",
      "description": "@Model.Article.Excerpt",
      "author": {
        "@@type": "Person",
        "name": "@Model.Article.AuthorName"
      },
      "datePublished": "@Model.Article.PublishedDateUtc.ToString("o")",
      "dateModified": "@(Model.Article.ModifiedDateUtc?.ToString("o") ?? Model.Article.PublishedDateUtc.ToString("o"))",
      "publisher": {
        "@@type": "Organization",
        "name": "GiftCardBuy",
        "logo": {
          "@@type": "ImageObject",
          "url": "https://giftcardbuy.ir/logo.png"
        }
      }
    }
    </script>

    <div class="container mx-auto px-4 py-10 max-w-3xl">
        <nav class="breadcrumb text-xs text-gray-500 mb-6 flex items-center gap-2">
            <a href="/" class="hover:text-indigo-600">خانه</a>
            <span>/</span>
            <a href="/Blog" class="hover:text-indigo-600">وبلاگ</a>
            <span>/</span>
            <span class="text-gray-800 font-semibold">@Model.Article.Title</span>
        </nav>

        <article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
            <header class="mb-8 border-b border-gray-100 pb-6">
                <span class="bg-indigo-50 text-indigo-700 text-xs px-3 py-1 rounded-full font-bold mb-3 inline-block">
                    @Model.Article.CategoryName
                </span>
                <h1 class="text-2xl md:text-3xl font-black text-gray-900 mb-4 leading-tight">
                    @Model.Article.Title
                </h1>
                <div class="flex items-center gap-4 text-xs text-gray-400">
                    <span>نویسنده: @Model.Article.AuthorName</span>
                    <span>•</span>
                    <span>انتشار: @Model.Article.PublishedDateUtc.ToString("yyyy/MM/dd")</span>
                </div>
            </header>

            <div class="article-body prose prose-indigo max-w-none text-sm leading-relaxed text-gray-700 space-y-4">
                @Html.Raw(Model.Article.BodyHtml)
            </div>

            <footer class="mt-8 pt-6 border-t border-gray-100 flex flex-wrap gap-2">
                @foreach (var tag in Model.Article.Tags)
                {
                    <span class="tag-pill bg-gray-100 text-gray-600 text-xs px-3 py-1 rounded-md">#@tag</span>
                }
            </footer>
        </article>
    </div>
}
