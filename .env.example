# GiftCardBuy Environment Configuration Template
ASPNETCORE_ENVIRONMENT=Development

# Database Configuration (PostgreSQL)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=giftcardbuy_db;Username=postgres;Password=YourSecurePassword123!;Include Error Detail=true;
ConnectionStrings__CmsConnection=Host=localhost;Port=5432;Database=giftcardbuy_cms;Username=postgres;Password=YourSecurePassword123!;Include Error Detail=true;

# Redis Configuration
ConnectionStrings__Redis=localhost:6379,abortConnect=false

# Gift-i-Card Supplier Configuration
Gifticard__Environment=Sandbox
Gifticard__Sandbox__BaseUrl=https://api.gifticard.ir/
Gifticard__Sandbox__ApiToken=YOUR_SANDBOX_TOKEN_HERE
Gifticard__Sandbox__ConsumerKey=YOUR_SANDBOX_CONSUMER_KEY
Gifticard__Sandbox__ConsumerSecret=YOUR_SANDBOX_CONSUMER_SECRET
Gifticard__Production__BaseUrl=https://api.gifticard.ir/
Gifticard__Production__ApiToken=YOUR_PROD_TOKEN_HERE
Gifticard__Production__ConsumerKey=YOUR_PROD_CONSUMER_KEY
Gifticard__Production__ConsumerSecret=YOUR_PROD_CONSUMER_SECRET
Gifticard__UseFakeInDevelopment=true

# Payment Gateway Configuration
Payment__Provider=Fake
Payment__Fake__AutoApprove=true
Payment__Zarinpal__MerchantId=00000000-0000-0000-0000-000000000000
Payment__Zarinpal__IsSandbox=true
Payment__CallbackBaseUrl=https://localhost:7001/checkout/payment-return

# CMS / Orchard Core Integration
Cms__BaseUrl=http://localhost:5050/
Cms__ApiKey=YOUR_INTERNAL_CMS_SYNC_SECRET_KEY
Cms__WebhookSecret=YOUR_SECURE_WEBHOOK_SECRET_KEY
Cms__CacheTtlMinutes=60

# Data Protection Keys Persistence Path
DataProtection__KeyDirectory=/var/keys/dataprotection

# Security & Admin Initial Setup
AdminSeed__Email=admin@giftcardbuy.local
AdminSeed__Password=Admin@SecurePass2026!
